function getSel()
{
	if( window.getSelection )
	{
		txt_quote = window.getSelection().toString();
	} else if( document.getSelection )
	{
		txt_quote = document.getSelection();
	} else if( document.selection )
	{
		txt_quote = document.selection.createRange().text;
	}
}
