function doSpoiler(obj)
{
	t = $(obj)
	t.parent().children('div.sp-body').slideToggle('fast');
	if(!t.hasClass("inited"))
	{
		t.addClass("inited");
  	} else
  	{
  		t.toggleClass("inited")
  	}
	return false;
}

function setTimeSel( item )
{
  ty = $1(item+'_ty').value
  tm = $1(item+'_tm').value
  td = $1(item+'_td').value
  th = $1(item+'_th').value
  tmn = $1(item+'_tmn').value
  ts = $1(item+'_ts').value
  ct = new Date(ty, tm, td)
  $1(item+'_time').value = Date.parse(ct)/1000 + parseInt(ts) + parseInt(tmn*60) + parseInt(th*60*60)
}


function getTimeSel( time , item )
{
  dt = new Date( time*1000 )
  $1(item+'_ts').value = dt.getSeconds()
  $1(item+'_tmn').value = dt.getMinutes()
  $1(item+'_th').value = dt.getHours()
  $1(item+'_td').value = dt.getDate()
  $1(item+'_tm').value = dt.getMonth()
  $1(item+'_ty').value = dt.getFullYear()
}

( function($)
{
	jQuery.fn.smartScrollToTop = function(options)
	{
		var element=this,inAnimate=false;
		var settings=$.extend
		(
			{
				speed:false,
				classInTop:"toup",
				classInAct:"toback",
				fadeIn:600,
				fadeOut:600,
				fromTop:150
			},
			options
		);
		var method =
		{
			showButton: function()
			{
				$(window).scroll( function()
				{
					if( $(this).scrollTop()>settings.fromTop)
						element.fadeIn( settings.fadeIn )
					if( $(this).scrollTop()>settings.fromTop && element.hasClass( settings.classInTop ) )
					{
						element.removeClass( settings.classInTop );
						element.removeClass( settings.classInAct )
					};
					if( $(this).scrollTop()<settings.fromTop && !element.hasClass(settings.classInTop) && !inAnimate)
						element.fadeOut(settings.fadeOut)
				});
				return false
			},
			scroll:function(pos,flag,el)
			{
				if(settings.speed===false)
					settings.speed=0
				inAnimate=true;
				$("html, body").stop().animate
				(
					{scrollTop:pos},
					settings.speed,
					function()
					{
						if(flag=="add")
							el.addClass(settings.classInTop)
						else
							el.removeClass(settings.classInTop)
						inAnimate=false
					}
				);
				return false
			}
		};
		return this.each( function()
		{
			method.showButton();
			element.on("click",function()
			{
				if(!$(this).hasClass(settings.classInAct))
				{
					$(this).addClass(settings.classInAct);
					topPos=(window.pageYOffset!==undefined)?window.pageYOffset:(document.documentElement||document.body.parentNode||document.body).scrollTop;
					method.scroll(0,"add",$(this))
				}
				else
				{
					$(this).removeClass(settings.classInAct);
					method.scroll(topPos,"remove",$(this))
				};
				return false
			})
		})
	}
})(jQuery);

$.prototype.enable = function()
{
	$.each(this, function(index, el){$(el).removeAttr('disabled')});
}
$.prototype.disable = function()
{
	$.each(this, function(index, el){$(el).attr('disabled', 'disabled')});
}
$.prototype.disabled = function( count )
{
	el = this ;
	el.disable();
	setTimeout(function(){el.enable()}, count);
}

function alertJsonError( json )
{
	if( json['error'] )
	{
		var error = '' ;
		for (i in json['error'])
			error += json['error'][i] ;
		alert( error )
	}
}

$.fn.isset = function()
{
	return this.length > 0;
};

